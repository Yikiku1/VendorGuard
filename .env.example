# Copy this file to .env for local development. Do not commit .env.
VENDORGUARD_APP_NAME=VendorGuard
VENDORGUARD_ENVIRONMENT=development
VENDORGUARD_DEBUG=false

# PostgreSQL + pgvector container. Use a unique local password in .env.
VENDORGUARD_DB_NAME=vendorguard
VENDORGUARD_DB_USER=vendorguard
VENDORGUARD_DB_PASSWORD=replace-with-a-long-random-password
VENDORGUARD_DB_HOST=127.0.0.1
VENDORGUARD_DB_PORT=5433
VENDORGUARD_DB_DATA_DIR=D:/DockerData/VendorGuard/postgres
