# 将此文件复制为 .env，用于本地开发。不要提交 .env 文件。
VENDORGUARD_APP_NAME=VendorGuard
VENDORGUARD_ENVIRONMENT=development
VENDORGUARD_DEBUG=false

# PostgreSQL + pgvector 容器配置。请在 .env 中使用独立的本地密码。
VENDORGUARD_DB_NAME=vendorguard
VENDORGUARD_DB_USER=vendorguard
VENDORGUARD_DB_PASSWORD=replace-with-a-long-random-password
VENDORGUARD_DB_HOST=127.0.0.1
VENDORGUARD_DB_PORT=5433
VENDORGUARD_DB_DATA_DIR=D:/DockerData/VendorGuard/postgres

# JWT 签名配置。请在 .env 中替换示例值，切勿提交真实密钥。
VENDORGUARD_JWT_SECRET=replace-with-at-least-32-random-characters
VENDORGUARD_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 演示账号密码。请在本地 .env 中替换示例值，切勿提交真实密码。
VENDORGUARD_DEMO_SPECIALIST_PASSWORD=replace-with-a-specialist-demo-password
VENDORGUARD_DEMO_MANAGER_PASSWORD=replace-with-a-manager-demo-password

# Agent 模型配置（仅 python -m vendorguard.agent 使用，后端不读）。
# 百炼 OpenAI 兼容协议端点，切勿提交真实密钥。
VENDORGUARD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VENDORGUARD_LLM_MODEL=qwen3.7-flash
VENDORGUARD_LLM_API_KEY=replace-with-your-dashscope-api-key

# 制度检索的 embedding 配置（M3）。默认复用上面的兼容协议端点与密钥。
# 缓存是调用付费接口算出的派生物，不入公开仓库；模型名或正文变化会让整份失效重建。
VENDORGUARD_EMBEDDING_MODEL=qwen3.7-text-embedding
VENDORGUARD_EMBEDDING_CACHE_PATH=data/retrieval/cache/embedding_v1.json

# M4 本地审查记录目录（工作台的上传材料与每轮结果都落在这里）。
# 它是演示证据，不是业务数据：目录已在 .gitignore 中忽略，随演示环境清理即可。
VENDORGUARD_REVIEW_DATA_DIR=var/reviews
